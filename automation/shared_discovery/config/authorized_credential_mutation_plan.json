{
  "schema": "the-world-authorized-credential-mutation-plan/v1",
  "mode": "synthetic_test_only",
  "target": "kabeya-authorized-test-range.onrender.com",
  "synthetic_credentials": [
    {
      "credential_id": "kabeya-synthetic-test-token",
      "target": "kabeya-authorized-test-range.onrender.com",
      "env_var": "AUTHORIZED_TEST_SYNTHETIC_TOKEN",
      "header": "Authorization",
      "prefix": "Bearer ",
      "synthetic_only": true
    }
  ],
  "actions": [
    {
      "id": "credential-bound-contact-post",
      "method": "POST",
      "path": "/contact/index.html",
      "alternate_paths": [
        "/contact/"
      ],
      "content_type": "application/x-www-form-urlencoded",
      "body": "name=credential-bound-loop&message=synthetic-authorized-action"
    },
    {
      "id": "credential-bound-record-put",
      "method": "PUT",
      "path": "/login-lab/synthetic-records/credential-bound-loop",
      "alternate_paths": [
        "/login-lab/synthetic-records/credential-bound-loop/"
      ],
      "content_type": "application/json",
      "body": "{\"synthetic\":true,\"source\":\"credential-bound-authority-loop\"}"
    },
    {
      "id": "credential-bound-record-patch",
      "method": "PATCH",
      "path": "/login-lab/synthetic-records/credential-bound-loop",
      "alternate_paths": [
        "/login-lab/synthetic-records/credential-bound-loop/"
      ],
      "content_type": "application/json",
      "body": "{\"synthetic\":true,\"note\":\"bounded-mutation-recovery\"}"
    }
  ]
}
