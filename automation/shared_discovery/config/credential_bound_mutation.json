{
  "schema": "the-world-credential-bound-mutation-config/v1",
  "bindings": [
    {
      "id": "kabeya-synthetic-bearer",
      "host": "kabeya-authorized-test-range.onrender.com",
      "owner_authorization": "explicit",
      "credential_scope": "synthetic_test_bearer",
      "secret_env": "KABEYA_TEST_BEARER_TOKEN",
      "header": "Authorization",
      "prefix": "Bearer ",
      "methods": ["POST", "PUT", "PATCH"],
      "synthetic_only": true
    }
  ],
  "mutations": [
    {
      "id": "credential-contact-submit",
      "host": "kabeya-authorized-test-range.onrender.com",
      "credential_binding": "kabeya-synthetic-bearer",
      "capability": "write",
      "method": "POST",
      "primary_path": "/contact/index.html",
      "alternate_paths": ["/contact/"],
      "content_type": "application/x-www-form-urlencoded",
      "payload_mode": "form_synthetic",
      "static_fields": {
        "name": "credential-bound-agent",
        "message": "synthetic authorized credential mutation"
      },
      "payload_variants": 2
    },
    {
      "id": "credential-synthetic-record-put",
      "host": "kabeya-authorized-test-range.onrender.com",
      "credential_binding": "kabeya-synthetic-bearer",
      "capability": "mutation",
      "method": "PUT",
      "primary_path": "/login-lab/synthetic-records/credential-loop",
      "alternate_paths": [
        "/login-lab/synthetic-records/credential-loop-alt"
      ],
      "content_type": "application/json",
      "payload_mode": "json_synthetic",
      "static_fields": {
        "source": "credential-bound-mutation-loop",
        "operation": "upsert"
      },
      "payload_variants": 2
    },
    {
      "id": "credential-synthetic-record-patch",
      "host": "kabeya-authorized-test-range.onrender.com",
      "credential_binding": "kabeya-synthetic-bearer",
      "capability": "mutation",
      "method": "PATCH",
      "primary_path": "/login-lab/synthetic-records/credential-loop",
      "alternate_paths": [
        "/login-lab/synthetic-records/credential-loop-alt"
      ],
      "content_type": "application/json",
      "payload_mode": "json_synthetic",
      "static_fields": {
        "source": "credential-bound-mutation-loop",
        "operation": "update"
      },
      "payload_variants": 3
    }
  ],
  "limits": {
    "max_mutations_per_cycle": 6,
    "max_attempts_per_mutation": 6,
    "max_request_bytes": 16384,
    "max_response_bytes": 131072
  },
  "failure_policy": {
    "retry_payload_variant": true,
    "alternate_path_same_exact_host": true,
    "cross_host_failover": false,
    "authority_expansion_on_failure": false,
    "credential_scope_expansion_on_failure": false,
    "terminal_or_revoked_retry": false
  }
}
